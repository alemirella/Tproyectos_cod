# En macOS el puerto 5000 suele estar ocupado por AirPlay; usa 5001 si falla.
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/HorariosAcademicos
# MONGO_URI=mongodb://USUARIO:CONTRASEÑA@127.0.0.1:27017/HorariosAcademicos?authSource=admin
MONGO_DB_NAME=HorariosAcademicos
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
